{
  "name": "filbert-js",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "keywords": [
    "styles",
    "filbert",
    "react",
    "css",
    "css-in-js"
  ],
  "scripts": {
    "test": "pnpm --filter @filbert-js/tests test",
    "test:watch": "pnpm --filter @filbert-js/tests test:watch",
    "bench": "pnpm --filter @filbert-js/tests bench",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint packages tests --ignore-path .oxlintignore",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@changesets/cli": "^2.27.0",
    "@types/babel__core": "^7.20.5",
    "oxlint": "^0.15.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/filbert-js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "oxc-parser"
    ]
  }
}
