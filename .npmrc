# pnpm settings.
# `auto-install-peers` matches yarn/npm default expectations and makes
# transient peer deps (React 18 across our React consumers) resolve without
# an explicit devDependency ladder.
auto-install-peers=true
# Strict peer deps off — some legacy packages (autoprefixer, macro) still
# declare React 16 as a peer via their own package.json; the workspace pins
# React 18 in tests/ and it works fine.
strict-peer-dependencies=false
# Save exact versions in package.json for reproducibility.
save-exact=false
# pnpm hoisting model — public-hoist a couple of things that plugins with
# CJS `require()` still expect to find at the top-level (webpack loader).
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*
