{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // `tsc --noEmit` still reports ~11 pre-existing TS2307/TS2304 module-resolution
    // errors (stylis, @babel/types, magic-string, ...) — those deps resolve via
    // vitest aliases at runtime, not tsconfig paths. Unrelated to the strict flags.
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
