{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@filbert-js/*": ["packages/*"],
      "react": ["tests/node_modules/@types/react"],
      "react/*": ["tests/node_modules/@types/react/*"],
      "react-dom": ["tests/node_modules/@types/react-dom"],
      "react-dom/*": ["tests/node_modules/@types/react-dom/*"]
    },
    "typeRoots": ["tests/node_modules/@types"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["**/node_modules", "**/dist", "website", "benchmarks", "examples"]
}
